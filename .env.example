# ==========================================
# JERSEYHUB ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================

# Database Configuration (PostgreSQL Container)
POSTGRES_DB=jerseyhub
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jerseyhub
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Server & Active Profile
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# JWT Security Configuration
# Secret must be a 256-bit (32-byte) hex-encoded key for HS256 algorithm
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# SSLCommerz Payment Gateway Configuration (Sandbox)
SSLCOMMERZ_STORE_ID=jerseyhub_sandbox_store
SSLCOMMERZ_STORE_PASSWORD=jerseyhub_sandbox_pass
SSLCOMMERZ_IS_SANDBOX=true

# Cloudinary Image Storage Service Configuration
CLOUDINARY_CLOUD_NAME=jerseyhub_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Frontend Client Environment Configuration
VITE_API_BASE_URL=http://localhost:8080/api/v1
